# Copia este archivo a .env.local y rellena los valores de tu proyecto de Supabase.
# Si los dejas vacíos, la app funciona en modo local (solo IndexedDB en este dispositivo).
# Supabase > Project Settings > API: "Project URL" y la clave pública "anon" / "publishable".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
